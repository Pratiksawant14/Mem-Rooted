# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://memrooted:memrooted_dev@localhost:5432/memrooted
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Scheduler ─────────────────────────────────────────
DECAY_INTERVAL_SECONDS=300
PROMOTION_INTERVAL_SECONDS=600
LATERAL_LINK_INTERVAL_SECONDS=900

# ── Memory Thresholds ────────────────────────────────
INSTANCE_DECAY_RATE=0.05
CLUSTER_DECAY_RATE=0.01
DOMAIN_DECAY_RATE=0.002
PROMOTION_THRESHOLD=0.75
DEMOTION_THRESHOLD=0.20
MERGE_SIMILARITY_THRESHOLD=0.85
LATERAL_LINK_THRESHOLD=0.70
ARCHIVE_THRESHOLD=0.05

# ── Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000
